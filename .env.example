# Database Configuration
# Get a free PostgreSQL database from: https://neon.tech or https://railway.app
DATABASE_URL=postgresql://user:password@host:5432/database

# Mapbox Configuration (REQUIRED)
# Get a free token from: https://account.mapbox.com/access-tokens/
MAPBOX_ACCESS_TOKEN=your_mapbox_token_here

# ===== DATA SOURCES =====
# The app uses GDELT and RSS feeds by default (NO API KEYS NEEDED!)
# ACLED is optional for enhanced data quality

# ACLED API (OPTIONAL - Register at: https://developer.acleddata.com/)
# Leave commented out if you don't have an API key - the app works without it!
# ACLED_API_KEY=your_acled_api_key_here
# ACLED_EMAIL=your_email@example.com

# ===== AI FEATURES (OPTIONAL) =====
# OpenAI/Claude API for AI summaries (future feature)
# OPENAI_API_KEY=sk-your_key_here
# OR
# ANTHROPIC_API_KEY=sk-ant-your_key_here

# Node Environment
NODE_ENV=development
