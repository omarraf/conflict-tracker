# Database Configuration
# Get a free PostgreSQL database from: https://neon.tech or https://railway.app
DATABASE_URL=postgresql://user:password@host:5432/database

# Mapbox Configuration
# Get a free token from: https://account.mapbox.com/access-tokens/
MAPBOX_ACCESS_TOKEN=your_mapbox_token_here

# API Keys for Data Sources
# ACLED API - Register at: https://developer.acleddata.com/
ACLED_API_KEY=your_acled_api_key_here
ACLED_EMAIL=your_email@example.com

# OpenAI/Claude API for AI summaries (optional)
OPENAI_API_KEY=your_openai_api_key_here
# OR
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Node Environment
NODE_ENV=development
